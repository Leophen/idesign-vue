{
  "name": "idesign-vue",
  "version": "1.1.8",
  "description": "iDesign 前端通用组件库",
  "engines": {
    "node": "22.x"
  },
  "main": "dist/idesign-vue.umd.cjs",
  "module": "dist/idesign-vue.js",
  "files": [
    "dist/*"
  ],
  "type": "module",
  "sideEffects": [
    "*.scss",
    "*.css",
    "dist/*"
  ],
  "scripts": {
    "start": "npm run docs:dev",
    "docs:dev": "cd vuepress && npm start",
    "playground": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "docs": "vue-tsc --noEmit && vite build && cd vuepress && yarn && yarn build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "overrides": {
    "@types/node": "18.19.68"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.182",
    "@types/tinycolor2": "^1.4.3",
    "@vitejs/plugin-vue": "^3.0.0",
    "@vitejs/plugin-vue-jsx": "^2.0.0",
    "@vue/test-utils": "next",
    "dayjs": "^1.11.4",
    "jsdom": "^20.0.0",
    "lodash": "^4.17.21",
    "sass": "^1.53.0",
    "tinycolor2": "^1.4.2",
    "typescript": "^4.6.4",
    "vite": "^3.0.0",
    "vitest": "^0.23.4",
    "vue": "^3.2.37",
    "vue-tsc": "^0.38.4"
  }
}
